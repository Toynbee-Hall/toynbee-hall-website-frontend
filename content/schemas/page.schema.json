{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toynbeehall.org.uk/schemas/page.schema.json",
  "title": "Toynbee Hall page content",
  "oneOf": [
    {
      "$ref": "#/$defs/brandPage"
    },
    {
      "$ref": "#/$defs/standardPage"
    },
    {
      "$ref": "#/$defs/articlePage"
    },
    {
      "$ref": "#/$defs/eventPage"
    },
    {
      "$ref": "#/$defs/resourcePage"
    },
    {
      "$ref": "#/$defs/listingPage"
    }
  ],
  "$defs": {
    "link": {
      "type": "object",
      "required": [
        "label",
        "href"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "href": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "media": {
      "type": "object",
      "required": [
        "src",
        "alt"
      ],
      "properties": {
        "src": {
          "type": "string"
        },
        "alt": {
          "type": "string",
          "description": "Meaningful alt text; empty only for decorative images."
        },
        "caption": {
          "type": "string"
        },
        "credit": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "tint": {
      "enum": [
        "orange",
        "jade",
        "blue",
        "yellow"
      ]
    },
    "contentBlock": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "paragraphs"
          ],
          "properties": {
            "type": {
              "const": "richText"
            },
            "headingAccent": {
              "type": "string"
            },
            "heading": {
              "type": "string"
            },
            "paragraphs": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "items"
          ],
          "properties": {
            "type": {
              "const": "linkList"
            },
            "heading": {
              "type": "string"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "label",
                  "href"
                ],
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "href": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "quote"
          ],
          "properties": {
            "type": {
              "const": "quote"
            },
            "variant": {
              "const": "editorial"
            },
            "quote": {
              "type": "string"
            },
            "attribution": {
              "type": "string"
            },
            "image": {
              "$ref": "#/$defs/media"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Several short quotes side by side, each with the person's name underneath.",
          "required": [
            "type",
            "items"
          ],
          "properties": {
            "type": {
              "const": "quoteGrid"
            },
            "id": {
              "type": "string"
            },
            "eyebrow": {
              "type": "string"
            },
            "heading": {
              "type": "string"
            },
            "intro": {
              "type": "string"
            },
            "items": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "required": [
                  "quote",
                  "name"
                ],
                "properties": {
                  "quote": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "detail": {
                    "type": "string"
                  },
                  "image": {
                    "$ref": "#/$defs/media"
                  }
                },
                "additionalProperties": false
              }
            },
            "align": {
              "const": "center",
              "description": "Brand pages: centre the heading and intro (callout: all copy)."
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "heading",
            "body"
          ],
          "properties": {
            "type": {
              "const": "callout"
            },
            "heading": {
              "type": "string"
            },
            "body": {
              "type": "string"
            },
            "link": {
              "$ref": "#/$defs/link"
            },
            "align": {
              "const": "center",
              "description": "Brand pages: centre the heading and intro (callout: all copy)."
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "headingLines"
          ],
          "properties": {
            "type": {
              "const": "hero"
            },
            "variant": {
              "const": "full-bleed"
            },
            "eyebrow": {
              "type": "string"
            },
            "headingLines": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "body": {
              "type": "string"
            },
            "image": {
              "$ref": "#/$defs/media"
            },
            "link": {
              "$ref": "#/$defs/link"
            },
            "secondaryLink": {
              "$ref": "#/$defs/link"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "items"
          ],
          "properties": {
            "type": {
              "const": "cardGrid"
            },
            "variant": {
              "const": "pathways"
            },
            "headingAccent": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "eyebrow": {
              "type": "string"
            },
            "heading": {
              "type": "string"
            },
            "numbered": {
              "type": "boolean"
            },
            "intro": {
              "type": "string"
            },
            "columns": {
              "enum": [
                2,
                3
              ]
            },
            "imageStyle": {
              "const": "icon"
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "title"
                ],
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "href": {
                    "type": "string"
                  },
                  "linkLabel": {
                    "type": "string"
                  },
                  "theme": {
                    "$ref": "#/$defs/tint"
                  },
                  "image": {
                    "$ref": "#/$defs/media"
                  },
                  "meta": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            },
            "align": {
              "const": "center",
              "description": "Brand pages: centre the heading and intro (callout: all copy)."
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "heading",
            "items"
          ],
          "properties": {
            "type": {
              "const": "timeline"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "eyebrow": {
              "type": "string"
            },
            "heading": {
              "type": "string"
            },
            "intro": {
              "type": "string"
            },
            "link": {
              "$ref": "#/$defs/link"
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "date",
                  "title",
                  "body"
                ],
                "properties": {
                  "date": {
                    "type": "string"
                  },
                  "dateTime": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "body": {
                    "type": "string"
                  },
                  "image": {
                    "$ref": "#/$defs/media"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "heading",
            "image"
          ],
          "properties": {
            "type": {
              "const": "splitBanner"
            },
            "eyebrow": {
              "type": "string"
            },
            "heading": {
              "type": "string"
            },
            "body": {
              "type": "string"
            },
            "image": {
              "$ref": "#/$defs/media"
            },
            "imagePosition": {
              "enum": [
                "left",
                "right"
              ]
            },
            "link": {
              "$ref": "#/$defs/link"
            },
            "theme": {
              "enum": [
                "orange",
                "navy",
                "yellow"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "heading"
          ],
          "properties": {
            "type": {
              "const": "statement"
            },
            "eyebrow": {
              "type": "string"
            },
            "heading": {
              "type": "string"
            },
            "paragraphs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "link": {
              "$ref": "#/$defs/link"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "heading",
            "readLabel",
            "items"
          ],
          "properties": {
            "type": {
              "const": "newsList"
            },
            "variant": {
              "const": "editorial"
            },
            "headingAccent": {
              "type": "string"
            },
            "eyebrow": {
              "type": "string"
            },
            "heading": {
              "type": "string"
            },
            "allLink": {
              "$ref": "#/$defs/link"
            },
            "readLabel": {
              "type": "string"
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "title",
                  "href",
                  "summary",
                  "image"
                ],
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "href": {
                    "type": "string"
                  },
                  "summary": {
                    "type": "string"
                  },
                  "image": {
                    "$ref": "#/$defs/media"
                  },
                  "category": {
                    "type": "string"
                  },
                  "date": {
                    "type": "string"
                  },
                  "byline": {
                    "type": "string"
                  },
                  "theme": {
                    "enum": [
                      "orange",
                      "blue"
                    ]
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "heading",
            "paragraphs",
            "images"
          ],
          "properties": {
            "type": {
              "const": "imageText"
            },
            "variant": {
              "const": "editorial"
            },
            "headingAccent": {
              "type": "string"
            },
            "eyebrow": {
              "type": "string"
            },
            "heading": {
              "type": "string"
            },
            "paragraphs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "images": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/media"
              },
              "minItems": 1,
              "maxItems": 2
            },
            "imagePosition": {
              "enum": [
                "left",
                "right"
              ]
            },
            "link": {
              "$ref": "#/$defs/link"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "heading",
            "paragraphs",
            "fields",
            "submitLabel"
          ],
          "properties": {
            "type": {
              "const": "newsletterSignup"
            },
            "eyebrow": {
              "type": "string"
            },
            "heading": {
              "type": "string"
            },
            "paragraphs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "privacy": {
              "type": "object",
              "required": [
                "text",
                "link"
              ],
              "properties": {
                "text": {
                  "type": "string"
                },
                "link": {
                  "$ref": "#/$defs/link"
                }
              },
              "additionalProperties": false
            },
            "instructions": {
              "type": "string"
            },
            "fields": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "label",
                  "type"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "type": {
                    "enum": [
                      "email",
                      "text"
                    ]
                  },
                  "required": {
                    "type": "boolean"
                  },
                  "autoComplete": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            },
            "submitLabel": {
              "type": "string"
            },
            "action": {
              "type": "string",
              "description": "Submission endpoint. Without it the form renders but does not submit."
            },
            "fallbackLink": {
              "$ref": "#/$defs/link"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "label",
            "logos"
          ],
          "properties": {
            "type": {
              "const": "logoGrid"
            },
            "label": {
              "type": "string"
            },
            "heading": {
              "type": "string"
            },
            "logos": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/media"
              },
              "minItems": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "sections"
          ],
          "properties": {
            "type": {
              "const": "longForm"
            },
            "sections": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "required": [
                      "type",
                      "text"
                    ],
                    "properties": {
                      "type": {
                        "const": "heading"
                      },
                      "level": {
                        "enum": [
                          2,
                          3
                        ]
                      },
                      "text": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "required": [
                      "type",
                      "text"
                    ],
                    "properties": {
                      "type": {
                        "const": "paragraph"
                      },
                      "text": {
                        "type": "string"
                      },
                      "links": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": [
                            "text",
                            "href"
                          ],
                          "properties": {
                            "text": {
                              "type": "string"
                            },
                            "href": {
                              "type": "string"
                            }
                          },
                          "additionalProperties": false
                        }
                      }
                    },
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "required": [
                      "type",
                      "items"
                    ],
                    "properties": {
                      "type": {
                        "const": "list"
                      },
                      "ordered": {
                        "type": "boolean"
                      },
                      "items": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "minItems": 1
                      }
                    },
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "required": [
                      "type",
                      "image"
                    ],
                    "properties": {
                      "type": {
                        "const": "image"
                      },
                      "image": {
                        "$ref": "#/$defs/media"
                      }
                    },
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "required": [
                      "type",
                      "quote"
                    ],
                    "properties": {
                      "type": {
                        "const": "quote"
                      },
                      "quote": {
                        "type": "string"
                      },
                      "attribution": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": false
                  }
                ]
              },
              "minItems": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "images"
          ],
          "properties": {
            "type": {
              "const": "imageGallery"
            },
            "heading": {
              "type": "string"
            },
            "intro": {
              "type": "string"
            },
            "images": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/media"
              },
              "minItems": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "heading",
            "stats"
          ],
          "properties": {
            "type": {
              "const": "impactStats"
            },
            "eyebrow": {
              "type": "string"
            },
            "heading": {
              "type": "string"
            },
            "intro": {
              "type": "string"
            },
            "stats": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "value",
                  "label"
                ],
                "properties": {
                  "value": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "detail": {
                    "type": "string"
                  },
                  "source": {
                    "$ref": "#/$defs/link"
                  }
                },
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "heading",
            "steps"
          ],
          "properties": {
            "type": {
              "const": "steps"
            },
            "variant": {
              "const": "connected"
            },
            "eyebrow": {
              "type": "string"
            },
            "heading": {
              "type": "string"
            },
            "intro": {
              "type": "string"
            },
            "steps": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "title",
                  "body"
                ],
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "body": {
                    "type": "string"
                  },
                  "link": {
                    "$ref": "#/$defs/link"
                  },
                  "time": {
                    "type": "string"
                  },
                  "icon": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "heading"
          ],
          "properties": {
            "type": {
              "const": "infoPanel"
            },
            "theme": {
              "enum": [
                "blue",
                "orange",
                "jade"
              ]
            },
            "heading": {
              "type": "string"
            },
            "paragraphs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "link": {
              "$ref": "#/$defs/link"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "contacts"
          ],
          "properties": {
            "type": {
              "const": "contactRoutes"
            },
            "heading": {
              "type": "string"
            },
            "contacts": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  },
                  "phone": {
                    "type": "string"
                  },
                  "address": {
                    "type": "string"
                  },
                  "hours": {
                    "type": "string"
                  },
                  "link": {
                    "$ref": "#/$defs/link"
                  }
                },
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "heading",
            "rows"
          ],
          "properties": {
            "type": {
              "const": "schedule"
            },
            "heading": {
              "type": "string"
            },
            "intro": {
              "type": "string"
            },
            "updated": {
              "type": "string"
            },
            "rows": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "day",
                  "time",
                  "activity"
                ],
                "properties": {
                  "day": {
                    "type": "string"
                  },
                  "time": {
                    "type": "string"
                  },
                  "activity": {
                    "type": "string"
                  },
                  "audience": {
                    "type": "string"
                  },
                  "location": {
                    "type": "string"
                  },
                  "booking": {
                    "$ref": "#/$defs/link"
                  }
                },
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "heading",
            "resources"
          ],
          "properties": {
            "type": {
              "const": "resourceList"
            },
            "heading": {
              "type": "string"
            },
            "intro": {
              "type": "string"
            },
            "resources": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/resource"
              },
              "minItems": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "items"
          ],
          "properties": {
            "type": {
              "const": "accordion"
            },
            "heading": {
              "type": "string"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "title",
                  "body"
                ],
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "body": {
                    "type": "string"
                  },
                  "paragraphs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
